# ---------------------------------------------------------------------------
# Football Stats App - environment configuration
# Copy to `.env` and adjust as needed. All values have safe defaults in code.
# ---------------------------------------------------------------------------

# Cache location (SQLite) and TTL (seconds; 86400 == 24 hours)
SQLITE_CACHE_PATH=.cache/football_cache.db
CACHE_TTL_SECONDS=86400

# Scraper politeness controls
FBREF_MIN_SLEEP=2.0
FBREF_MAX_SLEEP=5.0
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MAX_RETRIES=2

# Fuzzy entity-matching threshold (0-100). 85 == "ratio >= 85" requirement.
FUZZY_MATCH_THRESHOLD=85

# Top-5 league set (comma separated) used for league weighting
TOP5_LEAGUES=Premier League,La Liga,Serie A,Bundesliga,Ligue 1

# API
API_HOST=127.0.0.1
API_PORT=8000
